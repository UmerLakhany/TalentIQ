{
  "name": "talentiq-backend",
  "version": "1.0.0",
  "description": "TalentIQ - AI-powered CV screening and recruitment backend",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch settings --ext ts,json --exec ts-node src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "start:prod": "npm run build && node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker": "nodemon --watch src --watch settings --ext ts,json --exec ts-node src/worker.ts",
    "worker:prod": "node dist/src/worker.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.9",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^7.0.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
